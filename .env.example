# SUS Data RAG — variáveis de ambiente
# Copie para .env e preencha conforme o uso.

# --- LLM (escolha uma opção) ---

# Ollama local (padrão — requer Ollama instalado e modelo baixado)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:14b

# OpenAI (alternativa — comente as linhas acima e descomente abaixo)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- DuckDB / Dados ---
# Caminho base dos Parquet processados (relativo ou absoluto)
# DATA_PROCESSED_PATH=data/processed

# --- R (fallback download SIA-PA/SIH-RD ausentes no FTP/S3) ---
# Se Rscript não estiver no PATH do sistema, informe o caminho completo.
# Windows (exemplo): RSCRIPT_PATH=C:\Program Files\R\R-4.6.0\bin\Rscript.exe
# Linux/Mac (R no PATH): deixar comentado ou RSCRIPT_PATH=Rscript
# RSCRIPT_PATH=Rscript

# --- API ---
# HOST=0.0.0.0
# PORT=8000
